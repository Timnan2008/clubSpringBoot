{
  "name": "qingpu-wfl-club-desktop",
  "version": "1.2.5",
  "private": true,
  "description": "Qingpu WFL Club Windows desktop client",
  "author": "Qingpu WFL Club",
  "main": "main.js",
  "scripts": {
    "build": "node mac/scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test mac/tests/*.test.cjs",
    "test:app": "node mac/tests/app-smoke.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:zip": "npm run build && electron-builder --win zip --x64",
    "test:unified": "node mac/tests/unified-smoke.cjs",
    "test:interface": "node mac/tests/interface-smoke.cjs",
    "test:layout": "node mac/tests/layout-smoke.cjs"
  },
  "build": {
    "appId": "com.qpwflshclub.desktop",
    "productName": "Qingpu WFL Club",
    "copyright": "Copyright © 2026 QPWFLHS Club",
    "directories": {
      "output": "release",
      "buildResources": "mac/assets"
    },
    "files": [
      "main.js",
      "mac/electron/**/*",
      "mac/dist/**/*",
      "mac/assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "mac/assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "青浦世外社团",
      "uninstallDisplayName": "青浦世外社团",
      "artifactName": "QingpuWFL-Club-Setup-${version}.${ext}",
      "installerIcon": "mac/assets/icon.ico",
      "uninstallerIcon": "mac/assets/icon.ico",
      "installerHeaderIcon": "mac/assets/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.9",
    "playwright-core": "1.63.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "gsap": "3.13.0",
    "ogl": "1.0.11",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  }
}
