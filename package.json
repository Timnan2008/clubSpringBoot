    "vgpu": "0.3.1"
  },
  "devDependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "esbuild": "0.25.9",
    "playwright-core": "1.63.0",
